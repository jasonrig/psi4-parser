"""Describe the documented Open Babel 3 molecular import API used by the adapter.

Open Babel's SWIG bindings do not ship Python type information. This deliberately
small stub covers only the public interfaces exercised by integration tests.
"""

from collections.abc import Iterator

# noinspection PyPep8Naming
class OBAtom:
    def GetIdx(self) -> int: ...
    def SetAtomicNum(self, number: int) -> None: ...
    def SetIsotope(self, number: int) -> None: ...
    def SetVector(self, x: float, y: float, z: float) -> None: ...
    def GetAtomicNum(self) -> int: ...
    def GetIsotope(self) -> int: ...
    def GetExactMass(self) -> float: ...
    def GetX(self) -> float: ...
    def GetY(self) -> float: ...
    def GetZ(self) -> float: ...

# noinspection PyPep8Naming
class OBMol:
    def __init__(self) -> None: ...
    def NewAtom(self) -> OBAtom: ...
    def AddBond(self, begin: int, end: int, order: int) -> bool: ...
    def ConnectTheDots(self) -> None: ...
    def PerceiveBondOrders(self) -> None: ...
    def GetInternalCoord(self) -> list[OBInternalCoord | None]: ...
    def GetDimension(self) -> int: ...
    def NumAtoms(self) -> int: ...
    def GetAtom(self, index: int) -> OBAtom | None: ...
    def GetTotalCharge(self) -> int: ...
    def GetTotalSpinMultiplicity(self) -> int: ...

# noinspection PyPep8Naming
class OBFormat:
    def Description(self) -> str: ...

# noinspection PyPep8Naming
class OBConversion:
    INOPTIONS: int

    def GetInFormat(self) -> OBFormat | None: ...
    def AddOption(self, option: str, option_type: int) -> None: ...
    def __init__(self) -> None: ...
    def SetInFormat(self, input_format: str, /) -> bool: ...
    def ReadFile(self, molecule: OBMol, path: str) -> bool: ...
    def Read(self, molecule: OBMol) -> bool: ...

# noinspection PyPep8Naming
def GetSymbol(atomic_number: int) -> str: ...

# noinspection PyPep8Naming
class OBBond:
    def GetBeginAtomIdx(self) -> int: ...
    def GetEndAtomIdx(self) -> int: ...
    def GetBondOrder(self) -> int: ...
    def IsAromatic(self) -> bool: ...

class OBInternalCoord:
    _a: OBAtom | None
    _b: OBAtom | None
    _c: OBAtom | None

# noinspection PyPep8Naming
def OBMolBondIter(molecule: OBMol) -> Iterator[OBBond]: ...

# noinspection PyPep8Naming
def GetAtomicNum(symbol: str) -> int: ...
