"""Type the Z3 interfaces used by plan verification and replay tests.

z3-solver 5.3.1.0 supplies no py.typed marker or stubs. This small boundary
follows the installed bindings and z3prover.github.io/api/html/z3.html.
"""

from typing import Final, override

class Context:
    def __init__(self, *, proof: bool = False) -> None: ...

class ExprRef:
    def sexpr(self) -> str: ...

class BoolRef(ExprRef): ...
class SeqRef(ExprRef): ...

class ArithRef(ExprRef):
    def __mul__(self, other: ArithRef) -> ArithRef: ...
    def __le__(self, other: ArithRef) -> BoolRef: ...
    def __ge__(self, other: ArithRef) -> BoolRef: ...

class CheckSatResult:
    @override
    def __eq__(self, other: object) -> bool: ...
    @override
    def __ne__(self, other: object) -> bool: ...

sat: Final[CheckSatResult]
unsat: Final[CheckSatResult]
unknown: Final[CheckSatResult]

class ModelRef:
    def eval(self, t: ExprRef, model_completion: bool = False) -> ExprRef: ...

class Solver:
    def __init__(self, *, ctx: Context | None = None) -> None: ...
    def set(self, *, timeout: int, rlimit: int) -> None: ...
    def add(self, *args: BoolRef) -> None: ...
    def check(self) -> CheckSatResult: ...
    def push(self) -> None: ...
    def pop(self, num: int = 1) -> None: ...
    def reason_unknown(self) -> str: ...
    def model(self) -> ModelRef: ...
    def proof(self) -> ExprRef: ...
    def to_smt2(self) -> str: ...
    def from_string(self, s: str) -> None: ...

def String(name: str, ctx: Context | None = None) -> SeqRef: ...
def StringVal(s: str, ctx: Context | None = None) -> SeqRef: ...
def Real(name: str, ctx: Context | None = None) -> ArithRef: ...
def RealVal(val: int | str, ctx: Context | None = None) -> ArithRef: ...
def Sum(*args: ArithRef) -> ArithRef: ...
def Distinct(*args: ExprRef) -> BoolRef: ...
def Not(a: BoolRef, ctx: Context | None = None) -> BoolRef: ...
def Bool(name: str, ctx: Context | None = None) -> BoolRef: ...
def And(*args: BoolRef) -> BoolRef: ...
def Or(*args: BoolRef) -> BoolRef: ...
def AtMost(*args: BoolRef | int) -> BoolRef: ...
def Implies(a: BoolRef, b: BoolRef, ctx: Context | None = None) -> BoolRef: ...
def get_version_string() -> str: ...
