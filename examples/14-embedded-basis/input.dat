molecule hydrogen {
    H  0.0  0.0  0.0
    H  0.0  0.0  0.74
    units angstrom
}

set {
    basis          "sto-3g"
    scf_type       "pk"
    e_convergence  1e-10
    d_convergence  1e-10
}

e_catalog = energy('scf', molecule=hydrogen)

basis {
    assign H local_h
    [local_h]
    ****
    H 0
    S 3 1.00
    3.42525091 0.15432897
    0.62391373 0.53532814
    0.16885540 0.44463454
    ****
}

e_embedded = energy('scf', molecule=hydrogen)
