import contextlib as _psi4_builder_contextlib
import psi4 as _psi4_builder_psi4

@_psi4_builder_contextlib.contextmanager
def _psi4_builder_isolated_options(modules):
    core = _psi4_builder_psi4.core
    options = core.get_options()
    previous_module = options.get_current_module()
    previous_namespace = core.IO.get_default_namespace()
    try:
        state = _psi4_builder_psi4.driver.p4util.prepare_options_for_modules(
            changedOnly=False, stateInsteadMediated=True
        )
        state['GLOBALS'] = {
            name: {
                'value': core.get_global_option(name),
                'has_changed': core.has_global_option_changed(name),
            }
            for name in core.get_global_option_list()
        }
        # These native modules supplement the public utility's module list.
        for module in dict.fromkeys(('ADC', 'DDX', 'F12', previous_module, *modules)):
            if not module or module in state:
                continue
            state[module] = {
                name: {
                    'value': core.get_local_option(module, name),
                    'has_changed': flags[0],
                }
                for name, flags in core.options_to_python(module).items()
            }
        if any(
            item['value'] is None
            for values in state.values()
            for item in values.values()
        ):
            raise ValueError('Cannot isolate opaque Psi4 option values')
        try:
            core.clean_options()
            core.get_options().set_current_module(previous_module)
            yield
        finally:
            core.clean_options()
            for module, values in state.items():
                for name, item in values.items():
                    if module == 'GLOBALS':
                        current = core.get_global_option(name)
                        if item['value'] != current or item['has_changed']:
                            core.set_global_option(name, item['value'])
                        if not item['has_changed']:
                            core.revoke_global_option_changed(name)
                    else:
                        current = core.get_local_option(module, name)
                        if item['value'] != current or item['has_changed']:
                            core.set_local_option(module, name, item['value'])
                        if not item['has_changed']:
                            core.revoke_local_option_changed(module, name)
    finally:
        try:
            core.get_options().set_current_module(previous_module)
        finally:
            core.IO.set_default_namespace(previous_namespace)

molecule formal_input_0 {
    0 1
    H  0.0  0.0  0.0
    H  0.0  0.0  0.8
    units angstrom
}

(psi4.core.clean)()

formal_geometry_0 = formal_input_0.clone()

with _psi4_builder_isolated_options(()):
    set {
        basis        "sto-3g"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          false
        scf_type     "PK"
    }

    formal_energy_0 = energy('hf', molecule=formal_geometry_0)

(psi4.core.clean)()

formal_geometry_1 = formal_input_0.clone()

with _psi4_builder_isolated_options(('PCM',)):
    set {
        basis        "sto-3g"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          true
        scf_type     "PK"
    }

    set PCM {
        pcm_scf_type  "total"
    }

    _psi4_builder_psi4.set_options({'PCM__INPUT': 'Units = AU\nMedium {\n  SolverType = IEFPCM\n  Solvent = Water\n  Nonequilibrium = False\n  DiagonalIntegrator = Collocation\n  DiagonalScaling = 1.07\n  MatrixSymm = True\n}\nCavity {\n  Type = GePol\n  Mode = Implicit\n  RadiiSet = UFF\n  Scaling = False\n  Area = 0.3\n}\n'})
    formal_energy_1 = energy('hf', molecule=formal_geometry_1)

(psi4.core.clean)()

formal_geometry_2 = formal_input_0.clone()

with _psi4_builder_isolated_options(('PCM',)):
    set {
        basis        "sto-3g"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          true
        scf_type     "PK"
    }

    set PCM {
        pcm_scf_type  "total"
    }

    _psi4_builder_psi4.set_options({'PCM__INPUT': 'Units = AU\nMedium {\n  SolverType = IEFPCM\n  Solvent = Explicit\n  Nonequilibrium = False\n  DiagonalIntegrator = Collocation\n  DiagonalScaling = 1.07\n  MatrixSymm = True\n  ProbeRadius = 2.5\n  Green<inside> { Type = Vacuum }\n  Green<outside> {\n    Type = UniformDielectric\n    Eps = 12.0\n  }\n}\nCavity {\n  Type = GePol\n  Mode = Implicit\n  RadiiSet = UFF\n  Scaling = False\n  Area = 0.3\n}\n'})
    formal_energy_2 = energy('hf', molecule=formal_geometry_2)

(psi4.core.clean)()

formal_geometry_3 = formal_input_0.clone()

with _psi4_builder_isolated_options(('PCM',)):
    set {
        basis        "sto-3g"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          true
        scf_type     "PK"
    }

    set PCM {
        pcm_scf_type  "total"
    }

    _psi4_builder_psi4.set_options({'PCM__INPUT': 'Units = AU\nMedium {\n  SolverType = CPCM\n  Solvent = Explicit\n  Nonequilibrium = False\n  DiagonalIntegrator = Collocation\n  DiagonalScaling = 1.07\n  Correction = 0.5\n  ProbeRadius = 2.5\n  Green<inside> { Type = Vacuum }\n  Green<outside> {\n    Type = UniformDielectric\n    Eps = 12.0\n  }\n}\nCavity {\n  Type = GePol\n  Mode = Implicit\n  RadiiSet = UFF\n  Scaling = False\n  Area = 0.3\n}\n'})
    formal_energy_3 = energy('hf', molecule=formal_geometry_3)

formal_results = {'vacuum': formal_energy_0, 'water': formal_energy_1, 'explicit_iefpcm': formal_energy_2, 'explicit_cpcm': formal_energy_3}

formal_geometries = {'h2': formal_input_0}
