Parsed Psithon:
import psi4
from psi4 import *
from psi4.core import *
from psi4.driver.diatomic import anharmonicity
from psi4.driver.gaussian_n import *
from psi4.driver.frac import ip_fitting, frac_traverse
from psi4.driver.aliases import *
from psi4.driver.driver_cbs import *
from psi4.driver.wrapper_database import database, db, DB_RGT, DB_RXN
from psi4.driver.wrapper_autofrag import auto_fragments
psi4_io = core.IOManager.shared_object()
hooh = geometry("""
    H  1.0  0.0  0.0
    O  0.0  0.0  0.0
    O  0.0  0.0  1.4
    H  0.0  1.0  1.4
    units angstrom
""","hooh")
core.IO.set_default_namespace("hooh")
core.set_global_option("BASIS", "cc-pvdz")
import psi4 as _psi4_builder_psi4
_psi4_builder_options_2 = _psi4_builder_psi4.driver.p4util.OptionsState(['SCF', 'MAXITER'], ['OPTKING', 'FROZEN_DIHEDRAL'])
try:
    core.set_local_option("SCF", "MAXITER", 100)
    _psi4_builder_psi4.core.set_local_option('OPTKING', 'FROZEN_DIHEDRAL', '1 2 3 4')
    e_opt = optimize('scf', molecule=hooh)
finally:
    _psi4_builder_options_2.restore()
