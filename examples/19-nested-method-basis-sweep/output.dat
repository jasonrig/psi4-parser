  ==> Input File <==

--------------------------------------------------------------------------
molecule hydrogen {
    H  0.0  0.0  0.0
    H  0.0  0.0  0.74
    units angstrom
}

set {
    scf_type  "pk"
    mp2_type  "conv"
}

# The basis and method loops run in the generated Psi4 input.
for basis_name in ['sto-3g', '6-31g']:
    set {
        basis  $basis_name
    }

    # Both conditional branches bind e_result before it is used.
    for method in ['scf', 'mp2']:
        if (method == 'scf'):
            e_result = energy(method, molecule=hydrogen)
        else:
            e_result = energy(method, molecule=hydrogen, freeze_core=True)

        (print)(basis_name, method, e_result)

    # Clear correlated integral files before changing basis.
    (psi4.core.clean)()
--------------------------------------------------------------------------

Parsed Psithon:
import psi4
from psi4 import *
from psi4.core import *
from psi4.driver.diatomic import anharmonicity
from psi4.driver.gaussian_n import *
from psi4.driver.frac import ip_fitting, frac_traverse
from psi4.driver.aliases import *
from psi4.driver.driver_cbs import *
from psi4.driver.wrapper_database import database, db, DB_RGT, DB_RXN
from psi4.driver.wrapper_autofrag import auto_fragments
psi4_io = core.IOManager.shared_object()
hydrogen = geometry("""
    H  0.0  0.0  0.0
    H  0.0  0.0  0.74
    units angstrom
""","hydrogen")
core.IO.set_default_namespace("hydrogen")
core.set_global_option("SCF_TYPE", "pk")
core.set_global_option("MP2_TYPE", "conv")
for basis_name in ['sto-3g', '6-31g']:
    core.set_global_option("BASIS", basis_name)
   
    for method in ['scf', 'mp2']:
        if (method == 'scf'):
            e_result = energy(method, molecule=hydrogen)
        else:
            e_result = energy(method, molecule=hydrogen, freeze_core=True)
        (print)(basis_name, method, e_result)
   
    (psi4.core.clean)()
