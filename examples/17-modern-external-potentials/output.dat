  ==> Input File <==

--------------------------------------------------------------------------
molecule hydrogen {
    H  0.0  0.0  -0.37
    H  0.0  0.0   0.37
    units angstrom
    symmetry c1
    no_com
    no_reorient
}

set {
    basis     "sto-3g"
    scf_type  "pk"
}

e_reference = energy('scf', molecule=hydrogen)

e_point = energy('scf', molecule=hydrogen, external_potentials={'points': [[0.05, 0.0, 0.0, 4.724315313644571]]})

e_gaussian = energy('scf', molecule=hydrogen, external_potentials={'diffuse': [[-0.05, 0.0, 0.0, -5.0, 0.7]]})

# STO-3G has two AO functions, so the potential matrix is 2 by 2.
e_combined = energy('scf', molecule=hydrogen, external_potentials={'points': [[0.05, 0.0, 0.0, 4.724315313644571]], 'diffuse': [[-0.05, 0.0, 0.0, -5.0, 0.7]], 'matrix': [[0.01,  0.0 ], [0.0 , -0.01]]})

(print)('Reference, point, Gaussian, combined energies (hartree):', e_reference, e_point, e_gaussian, e_combined)
--------------------------------------------------------------------------

Parsed Psithon:
import psi4
from psi4 import *
from psi4.core import *
from psi4.driver.diatomic import anharmonicity
from psi4.driver.gaussian_n import *
from psi4.driver.frac import ip_fitting, frac_traverse
from psi4.driver.aliases import *
from psi4.driver.driver_cbs import *
from psi4.driver.wrapper_database import database, db, DB_RGT, DB_RXN
from psi4.driver.wrapper_autofrag import auto_fragments
psi4_io = core.IOManager.shared_object()
hydrogen = geometry("""
    H  0.0  0.0  -0.37
    H  0.0  0.0   0.37
    units angstrom
    symmetry c1
    no_com
    no_reorient
""","hydrogen")
core.IO.set_default_namespace("hydrogen")
core.set_global_option("BASIS", "sto-3g")
core.set_global_option("SCF_TYPE", "pk")
e_reference = energy('scf', molecule=hydrogen)
e_point = energy('scf', molecule=hydrogen, external_potentials={'points': [[0.05, 0.0, 0.0, 4.724315313644571]]})
e_gaussian = energy('scf', molecule=hydrogen, external_potentials={'diffuse': [[-0.05, 0.0, 0.0, -5.0, 0.7]]})
e_combined = energy('scf', molecule=hydrogen, external_potentials={'points': [[0.05, 0.0, 0.0, 4.724315313644571]], 'diffuse': [[-0.05, 0.0, 0.0, -5.0, 0.7]], 'matrix': [[0.01,  0.0 ], [0.0 , -0.01]]})
(print)('Reference, point, Gaussian, combined energies (hartree):', e_reference, e_point, e_gaussian, e_combined)
