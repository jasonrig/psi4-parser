molecule hydrogen {
    H  0.0  0.0  -0.37
    H  0.0  0.0   0.37
    units angstrom
    symmetry c1
    no_com
    no_reorient
}

set {
    basis     "sto-3g"
    scf_type  "pk"
}

e_reference = energy('scf', molecule=hydrogen)

e_point = energy('scf', molecule=hydrogen, external_potentials={'points': [[0.05, 0.0, 0.0, 4.724315313644571]]})

e_gaussian = energy('scf', molecule=hydrogen, external_potentials={'diffuse': [[-0.05, 0.0, 0.0, -5.0, 0.7]]})

# STO-3G has two AO functions, so the potential matrix is 2 by 2.
e_combined = energy('scf', molecule=hydrogen, external_potentials={'points': [[0.05, 0.0, 0.0, 4.724315313644571]], 'diffuse': [[-0.05, 0.0, 0.0, -5.0, 0.7]], 'matrix': [[0.01,  0.0 ], [0.0 , -0.01]]})

(print)('Reference, point, Gaussian, combined energies (hartree):', e_reference, e_point, e_gaussian, e_combined)
