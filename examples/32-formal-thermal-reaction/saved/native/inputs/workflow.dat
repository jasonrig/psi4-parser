formal_results = {'opt:co': formal_energy_0, 'opt:oxygen': formal_energy_1, 'opt:co2': formal_energy_2, 'oxidation:frequency:co': formal_energy_3, 'oxidation:frequency:oxygen': formal_energy_5, 'oxidation:frequency:co2': formal_energy_7}

formal_geometries = {'co': formal_input_0, 'oxygen': formal_input_1, 'co2': formal_input_2, 'opt:co': formal_geometry_0, 'opt:oxygen': formal_geometry_1, 'opt:co2': formal_geometry_2}
