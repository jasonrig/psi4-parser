Parsed Psithon:
import psi4
from psi4 import *
from psi4.core import *
from psi4.driver.diatomic import anharmonicity
from psi4.driver.gaussian_n import *
from psi4.driver.frac import ip_fitting, frac_traverse
from psi4.driver.aliases import *
from psi4.driver.driver_cbs import *
from psi4.driver.wrapper_database import database, db, DB_RGT, DB_RXN
from psi4.driver.wrapper_autofrag import auto_fragments
psi4_io = core.IOManager.shared_object()
water = geometry("""
    O  0.0   0.0   0.0
    H  0.0   0.0   0.96
    H  0.93  0.0  -0.24
    units angstrom
""","water")
core.IO.set_default_namespace("water")
core.set_global_option("BASIS", "sto-3g")
core.set_global_option("SCF_TYPE", "pk")
core.set_local_option("SCF", "MAXITER", 37)
for limit in [1, 50]:
   
   
   
    try:
        import psi4 as _psi4_builder_psi4
        _psi4_builder_options_3 = _psi4_builder_psi4.driver.p4util.OptionsState(['SCF', 'MAXITER'])
        try:
            core.set_local_option("SCF", "MAXITER", limit)
            e_scf = energy('scf', molecule=water)
        finally:
            _psi4_builder_options_3.restore()
    except (psi4.driver.p4util.exceptions.SCFConvergenceError) as error:
        (print)('SCF attempt failed:', error)
    else:
        (print)('Converged energy (hartree):', e_scf)
    finally:
        (psi4.core.clean)()
        (print)('Restored SCF maxiter:', (psi4.core.get_option('SCF', 'MAXITER')))
