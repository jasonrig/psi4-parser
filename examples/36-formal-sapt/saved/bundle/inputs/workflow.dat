    }

    formal_energy_7 = energy('sapt0', molecule=formal_geometry_7, sapt_basis='monomer')

formal_subsystem_8 = formal_input_0.clone()

(formal_subsystem_8.set_active_fragment)(1)

(formal_subsystem_8.set_ghost_fragment)(2)

(formal_subsystem_8.set_molecular_charge)(0)

(formal_subsystem_8.set_multiplicity)(1)

(formal_subsystem_8.update_geometry)()

(psi4.core.clean)()

formal_geometry_9 = formal_subsystem_8.clone()

with _psi4_builder_isolated_options(()):
    set {
        basis        "cc-pvdz"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          false
        scf_type     "PK"
    }

    formal_energy_9 = energy('hf', molecule=formal_geometry_9)

