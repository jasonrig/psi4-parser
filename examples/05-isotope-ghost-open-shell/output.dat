deuterium = geometry("""
    0 2
    H@2.01410177812  0.0  0.0  0.0
    @H               0.0  0.0  1.5
    units angstrom
    symmetry c1
""","deuterium")
core.IO.set_default_namespace("deuterium")
core.set_global_option("BASIS", "cc-pvdz")
core.set_global_option("REFERENCE", "uhf")
core.set_global_option("SCF_TYPE", "pk")
e_atom = energy('scf', molecule=deuterium)
