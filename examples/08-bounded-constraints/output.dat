Parsed Psithon:
import psi4
from psi4 import *
from psi4.core import *
from psi4.driver.diatomic import anharmonicity
from psi4.driver.gaussian_n import *
from psi4.driver.frac import ip_fitting, frac_traverse
from psi4.driver.aliases import *
from psi4.driver.driver_cbs import *
from psi4.driver.wrapper_database import database, db, DB_RGT, DB_RXN
from psi4.driver.wrapper_autofrag import auto_fragments
psi4_io = core.IOManager.shared_object()
core.set_global_option("BASIS", "sto-3g")
core.set_global_option("SCF_TYPE", "pk")
hydrogen = geometry("""
    H  0.0  0.0  0.0
    H  0.0  0.0  1.0
    units angstrom
""","hydrogen")
core.IO.set_default_namespace("hydrogen")
import psi4 as _psi4_builder_psi4
_psi4_builder_options_2 = _psi4_builder_psi4.driver.p4util.OptionsState(['OPTKING', 'RANGED_DISTANCE'])
try:
    _psi4_builder_psi4.core.set_local_option('OPTKING', 'RANGED_DISTANCE', '1 2 0.952518979206 1.05835442134')
    e_bounded_bond = optimize('scf', molecule=hydrogen)
finally:
    _psi4_builder_options_2.restore()
water = geometry("""
    O  0.0   0.0                 0.0
    H  0.0   0.757               0.586
    H  0.0  -0.5177931958217856  0.805192651705579
    units angstrom
""","water")
core.IO.set_default_namespace("water")
import psi4 as _psi4_builder_psi4
_psi4_builder_options_4 = _psi4_builder_psi4.driver.p4util.OptionsState(['OPTKING', 'RANGED_BEND'])
try:
    _psi4_builder_psi4.core.set_local_option('OPTKING', 'RANGED_BEND', '2 1 3 80.0 90.0')
    e_bounded_angle = optimize('scf', molecule=water)
finally:
    _psi4_builder_options_4.restore()
