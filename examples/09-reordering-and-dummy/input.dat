molecule acetylene {
    C
    H  1 1.06
    X  1 1.0                 2 90.0
    C  3 1.5620499351813306  1 50.1944289077348   2 180.0
    H  3 2.4713559031430496  1 66.13166998669264  2 180.0
    units angstrom
}

set {
    basis     "sto-3g"
    scf_type  "pk"
}

import psi4 as _psi4_builder_psi4
_psi4_builder_options_2 = _psi4_builder_psi4.driver.p4util.OptionsState(['OPTKING', 'FROZEN_DISTANCE'])
try:
    _psi4_builder_psi4.core.set_local_option('OPTKING', 'FROZEN_DISTANCE', '1 3')
    e_opt = optimize('scf', molecule=acetylene)
finally:
    _psi4_builder_options_2.restore()
