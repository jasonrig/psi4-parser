  ==> Input File <==

--------------------------------------------------------------------------
molecule hydrogen {
    H  0.0  0.0  0.0
    H  0.0  0.0  0.74
    units angstrom
}

set {
    scf_type  "pk"
}

bases = (iter)(['sto-3g', '6-31g'])

basis_name = (next)(bases, None)

# The context manager closes the results file on every exit.
with (open('energies.csv', 'w', encoding='utf-8')) as summary:
    (print)('basis,energy_hartree', file=summary)

    while (basis_name is not None):
        set {
            basis  $basis_name
        }

        e_result = energy('scf', molecule=hydrogen)

        (print)(basis_name, e_result, file=summary, sep=',')

        basis_name = (next)(bases, None)
    else:
        (print)('Basis sweep complete.')
--------------------------------------------------------------------------

Parsed Psithon:
import psi4
from psi4 import *
from psi4.core import *
from psi4.driver.diatomic import anharmonicity
from psi4.driver.gaussian_n import *
from psi4.driver.frac import ip_fitting, frac_traverse
from psi4.driver.aliases import *
from psi4.driver.driver_cbs import *
from psi4.driver.wrapper_database import database, db, DB_RGT, DB_RXN
from psi4.driver.wrapper_autofrag import auto_fragments
psi4_io = core.IOManager.shared_object()
hydrogen = geometry("""
    H  0.0  0.0  0.0
    H  0.0  0.0  0.74
    units angstrom
""","hydrogen")
core.IO.set_default_namespace("hydrogen")
core.set_global_option("SCF_TYPE", "pk")
bases = (iter)(['sto-3g', '6-31g'])
basis_name = (next)(bases, None)
with (open('energies.csv', 'w', encoding='utf-8')) as summary:
    (print)('basis,energy_hartree', file=summary)
    while (basis_name is not None):
        core.set_global_option("BASIS", basis_name)
        e_result = energy('scf', molecule=hydrogen)
        (print)(basis_name, e_result, file=summary, sep=',')
        basis_name = (next)(bases, None)
    else:
        (print)('Basis sweep complete.')
