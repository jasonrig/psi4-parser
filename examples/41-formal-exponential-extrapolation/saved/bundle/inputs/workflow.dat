    formal_energy_3 = energy('hf', molecule=formal_geometry_3)

(psi4.core.clean)()

formal_geometry_5 = formal_input_0.clone()

with _psi4_builder_isolated_options(()):
    set {
        basis        "cc-pvtz"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          false
        scf_type     "PK"
        mp2_type     "CONV"
        qc_module    "OCC"
    }

    formal_energy_5 = energy('mp2', molecule=formal_geometry_5)

(psi4.core.clean)()

formal_geometry_7 = formal_input_0.clone()

with _psi4_builder_isolated_options(()):
    set {
        basis        "cc-pvqz"
        reference    "rhf"
        freeze_core  false
        puream       true
        ddx          false
        pcm          false
        scf_type     "PK"
        mp2_type     "CONV"
        qc_module    "OCC"
    }

    formal_energy_7 = energy('mp2', molecule=formal_geometry_7)

formal_results = {'linear_dt:low': formal_energy_0, 'linear_dt:high': formal_energy_1, 'sqrt_tq:high': formal_energy_3, 'correlation_tq:low:target': formal_energy_5, 'correlation_tq:high:target': formal_energy_7}

formal_geometries = {'water': formal_input_0}
