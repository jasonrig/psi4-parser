--------------------------------------------------------------------------
import math as formal_math

molecule formal_input_0 {
    0 1
    H  0.0  0.0  0.0
    H  0.0  0.0  0.74
    units angstrom
}

(psi4.core.clean)()

formal_geometry_0 = (formal_input_0.clone)()

import psi4 as _psi4_builder_psi4
_psi4_builder_options_4 = _psi4_builder_psi4.driver.p4util.OptionsState(['BASIS'], ['REFERENCE'])
try:
    set {
        basis      "cc-pvdz"
        reference  "rhf"
    }

    formal_energy_0 = energy('scf', molecule=formal_geometry_0)
finally:
    _psi4_builder_options_4.restore()

if not formal_math.isfinite(formal_energy_0):
    raise ArithmeticError('A formal plan energy is not finite')

(psi4.core.clean)()

formal_geometry_1 = (formal_input_0.clone)()

import psi4 as _psi4_builder_psi4
_psi4_builder_options_8 = _psi4_builder_psi4.driver.p4util.OptionsState(['BASIS'], ['REFERENCE'])
try:
    set {
        basis      "sto-3g"
        reference  "rhf"
    }

    formal_energy_1 = energy('mp2', molecule=formal_geometry_1)
finally:
    _psi4_builder_options_8.restore()

if not formal_math.isfinite(formal_energy_1):
    raise ArithmeticError('A formal plan energy is not finite')

(psi4.core.clean)()

formal_geometry_2 = (formal_input_0.clone)()

import psi4 as _psi4_builder_psi4
_psi4_builder_options_12 = _psi4_builder_psi4.driver.p4util.OptionsState(['BASIS'], ['REFERENCE'])
try:
    set {
        basis      "sto-3g"
        reference  "rhf"
    }

    formal_energy_2 = energy('scf', molecule=formal_geometry_2)
finally:
    _psi4_builder_options_12.restore()

if not formal_math.isfinite(formal_energy_2):
    raise ArithmeticError('A formal plan energy is not finite')

formal_energy_3 = (1 * formal_energy_1) + (-1 * formal_energy_2)

if not formal_math.isfinite(formal_energy_3):
    raise ArithmeticError('A formal plan energy is not finite')

formal_energy_4 = (1 * formal_energy_0) + (1 * formal_energy_3)

if not formal_math.isfinite(formal_energy_4):
    raise ArithmeticError('A formal plan energy is not finite')

formal_results = {'hf_large': formal_energy_0, 'mp2_small': formal_energy_1, 'hf_small': formal_energy_2, 'correction': formal_energy_3, 'estimate': formal_energy_4}

formal_geometries = {'h2': formal_input_0}
