    basis  "cc-pvdz"
}

# PES point: H-O-O-H dihedral = 30 degrees.
molecule hooh_30 {
    H  1.0                 0.0                 0.0
    O  0.0                 0.0                 0.0
    O  0.0                 0.0                 1.4
    H  0.8660254037844386  0.5000000000000001  1.4
    units angstrom
}

